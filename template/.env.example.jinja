# Copie para .env e ajuste. Nunca versione o .env.
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# Postgres (formato do SQLAlchemy com psycopg 3)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/{{ project_slug | replace('-', '_') }}

# Chave de acesso simples. Obrigatória (16+ caracteres) em produção.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
