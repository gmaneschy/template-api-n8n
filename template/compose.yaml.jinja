# Serviços do projeto. O banco sobe sempre; o resto é ligado por profile.
#
#   local:     COMPOSE_PROFILES=...      só o banco (e o que mais quiser); a API roda com `make dev`
#   servidor:  COMPOSE_PROFILES=app,proxy{% if use_n8n %},n8n{% endif %}   API, HTTPS (Caddy){% if use_n8n %} e n8n{% endif %}
#
# O COMPOSE_PROFILES é lido do .env. Nada é publicado para a internet além do Caddy (80/443);
# o que expõe porta no host fica preso em 127.0.0.1.

name: {{ project_slug }}

services:
  db:
    image: {{ 'pgvector/pgvector:pg17' if use_pgvector else 'postgres:17' }}
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-app}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?rode `make env` para gerar o .env}
      POSTGRES_DB: ${POSTGRES_DB:-{{ project_slug | replace('-', '_') }}}
{%- if use_n8n %}
      N8N_DB_PASSWORD: ${N8N_DB_PASSWORD:?rode `make env` para gerar o .env}
{%- endif %}
    volumes:
      - pgdata:/var/lib/postgresql/data
      # Scripts daqui só rodam na primeira vez, com o volume vazio.
      - ./infra/postgres/init:/docker-entrypoint-initdb.d:ro
    ports:
      - "127.0.0.1:${DB_PORT:-5432}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5

  api:
    profiles: [app]
    build: .
    image: {{ project_slug }}:latest
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      APP_ENV: ${APP_ENV:-production}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
      API_KEY: ${API_KEY:?rode `make env` para gerar o .env}
      DATABASE_URL: postgresql+psycopg://${POSTGRES_USER:-app}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB:-{{ project_slug | replace('-', '_') }}}
{%- if use_redis %}
      REDIS_URL: redis://redis:6379/0
{%- endif %}
    # Aplica as migrações antes de atender. Com uma única instância, isso basta.
    command:
      - sh
      - -c
      - alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*

  caddy:
    profiles: [proxy]
    image: caddy:2-alpine
    restart: unless-stopped
    environment:
      DOMAIN: ${DOMAIN:-localhost}
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./infra/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
{%- if use_n8n %}

  n8n:
    profiles: [n8n]
    # Fixe uma versão depois do primeiro teste (N8N_VERSION no .env) para o deploy ser reproduzível.
    image: n8nio/n8n:${N8N_VERSION:-latest}
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      # Banco próprio do n8n, no mesmo servidor Postgres (criado por infra/postgres/init).
      DB_TYPE: postgresdb
      DB_POSTGRESDB_HOST: db
      DB_POSTGRESDB_PORT: "5432"
      DB_POSTGRESDB_DATABASE: n8n
      DB_POSTGRESDB_USER: n8n
      DB_POSTGRESDB_PASSWORD: ${N8N_DB_PASSWORD:?rode `make env` para gerar o .env}
      # Cifra as credenciais guardadas. Se for perdida, as credenciais salvas ficam inúteis.
      N8N_ENCRYPTION_KEY: ${N8N_ENCRYPTION_KEY:?rode `make env` para gerar o .env}
      N8N_EDITOR_BASE_URL: ${N8N_URL:-http://localhost:5678}
      WEBHOOK_URL: ${N8N_URL:-http://localhost:5678}/
      N8N_PROXY_HOPS: "1"
      N8N_SECURE_COOKIE: ${N8N_SECURE_COOKIE:-false}
      N8N_DIAGNOSTICS_ENABLED: "false"
      N8N_PERSONALIZATION_ENABLED: "false"
      GENERIC_TIMEZONE: ${TZ:-America/Sao_Paulo}
      TZ: ${TZ:-America/Sao_Paulo}
    ports:
      - "127.0.0.1:5678:5678"
    volumes:
      - n8n_data:/home/node/.n8n
{%- endif %}
{%- if use_redis %}

  redis:
    profiles: [redis]
    image: redis:7-alpine
    restart: unless-stopped
    # noeviction: serve para fila (recusa escrita quando cheio). Para cache puro, use allkeys-lru.
    command: ["redis-server", "--maxmemory", "256mb", "--maxmemory-policy", "noeviction", "--appendonly", "yes"]
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
{%- endif %}
{%- if use_local_llm %}

  ollama:
    profiles: [llm]
    # A instância gratuita da Oracle não tem GPU: só modelos pequenos, e devagar.
    image: ollama/ollama:latest
    restart: unless-stopped
    ports:
      - "127.0.0.1:11434:11434"
    volumes:
      - ollama_data:/root/.ollama
{%- endif %}

volumes:
  pgdata:
  caddy_data:
  caddy_config:
{%- if use_n8n %}
  n8n_data:
{%- endif %}
{%- if use_redis %}
  redis_data:
{%- endif %}
{%- if use_local_llm %}
  ollama_data:
{%- endif %}
